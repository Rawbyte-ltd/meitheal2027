# Names only; real values live in Railway service variables (production) or .env.local (gitignored).
# scripts/check-env.mjs checks these on every production start; /api/health shows what is running degraded.

# Postgres. Railway injects DATABASE_URL from the attached Postgres service.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/meitheal
# Salts the IP fingerprints kept with stories and flags. 16+ characters; production will not start without it.
MEITHEAL_SALT=
# The public address, https, no trailing slash. Used in emails, share cards, the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://meitheal2027.ie
# Setup key for the reading desk (/desk?key=...) and /api/brief, until the first admin has signed in; then ignored.
ADMIN_KEY=

# Cloudflare R2 for recordings and photographs (all four, or none: without them media lives in Postgres).
# Create a bucket, then an API token with Object Read & Write on that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meitheal
# eu for a bucket created with EU jurisdiction (different S3 endpoint); leave empty otherwise.
R2_JURISDICTION=eu

# The checks (src/lib/scan.ts). They flag for a person and never publish or refuse anything by themselves.
# Cloudflare Workers AI checks photos and transcribes recordings. Token: My Profile → API Tokens → Create → Custom,
# permission Account · Workers AI · Read. The account defaults to R2_ACCOUNT_ID.
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Anthropic reads written stories, names, photo captions and transcripts, and writes the English for other languages.
ANTHROPIC_API_KEY=
# off: every teacher approval goes to a reader. Default: a teacher's approval publishes when every check is safe.
AUTO_PUBLISH=

# Outgoing mail (sign-in links, keeper links, the daily brief, flag alerts) through Zoho SMTP, as MAIL_FROM.
# MAIL_SMTP_USER is the Zoho mailbox itself, never the alias; meitheal@rawbyte.ie is an alias on it. The password is a
# Zoho app password shared with other Rawbyte services.
# Host, user and password all set, or none; without them mail is written to the server log.
MAIL_SMTP_HOST=smtppro.zoho.eu
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=Meitheal 2027 <meitheal@rawbyte.ie>
# Alternative to SMTP: Resend's HTTP API (verify the sending domain in Resend first).
RESEND_API_KEY=

# Who gets the 19:00 brief and flag alerts, and when (Europe/Dublin, HH:MM).
BRIEF_TO=meitheal@rawbyte.ie
BRIEF_AT=19:00

# Puts the whole site behind a password page while it is private. Unset: open (as since 12 October 2026).
SITE_PASSWORD=
